{
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/api/deals/:id",
      "destination": "/api/deals?id=:id"
    },
    {
      "source": "/api/admin",
      "destination": "/api/auth?action=admin"
    },
    {
      "source": "/d/:id",
      "destination": "/api/share?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hotdeal-omega.vercel.app"
        }
      ],
      "destination": "https://gaji.run/:path*",
      "permanent": true
    }
  ]
}
